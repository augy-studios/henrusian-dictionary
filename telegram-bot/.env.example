# Copy to .env and fill in. Never commit the filled copy.

# Telegram credentials from https://my.telegram.org (API development tools).
# Telethon needs these even for a bot login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Supabase project, service role key. Server side only, never expose this.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Where the donate button points.
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# Where the "Open the dictionary" button points, and the base for link deep links.
WEB_APP_URL=https://henrusian.uwuapps.org

# Your own Telegram numeric id. Gates /broadcast and /health.
# Leave empty to disable the owner commands entirely.
BOT_OWNER_ID=

# Optional. Relative paths resolve against the telegram-bot directory.
SQLITE_PATH=data/bot.db

# Optional. Default timezone for new subscribers, any IANA zone name.
DEFAULT_TIMEZONE=Asia/Singapore
